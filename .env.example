APP_NAME=ArcanePay
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.arcanepay.biz.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ──────────────────────────────────────────────
# Database — Supabase PostgreSQL
# Ambil dari: Supabase Dashboard → Settings → Database
# Gunakan "Session Mode" pooler (port 5432) untuk Railway
# ──────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.xxxx
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Untuk production: ganti ke 'database' dan setup Redis jika traffic tinggi
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@arcanepay.biz.id"
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────────
# WhatsApp via Fonnte
# Daftar: https://fonnte.com
# Token ada di dashboard Fonnte → Perangkat → Detail
# SECRET: buat sendiri (sembarang string), isi juga di setting webhook Fonnte
# ──────────────────────────────────────────────
FONNTE_TOKEN=
FONNTE_SECRET=

# ──────────────────────────────────────────────
# Payment Gateway — Tripay
# Daftar: https://tripay.co.id/daftar
# Setelah approved → Merchant → API
# ENV: sandbox | production
# ──────────────────────────────────────────────
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_ENV=sandbox

# ──────────────────────────────────────────────
# Supplier #1 — Digiflazz (Primary)
# Daftar: https://digiflazz.com/register
# API Key ada di: Member → Produksi → API
# ENV: dev | prod
# ──────────────────────────────────────────────
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY_DEV=
DIGIFLAZZ_API_KEY_PROD=
DIGIFLAZZ_ENV=dev

# ──────────────────────────────────────────────
# Supplier #2 — VIP Reseller (Backup, aktifkan jika sudah daftar)
# Daftar: https://vip-reseller.co.id
# VIPRESELLER_ACTIVE: false → true setelah ada akun
# ──────────────────────────────────────────────
VIPRESELLER_API_KEY=
VIPRESELLER_API_ID=
VIPRESELLER_ACTIVE=false

VITE_APP_NAME="${APP_NAME}"
