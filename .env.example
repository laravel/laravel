APP_NAME=Laravel
# Possible values: local, staging, production, testing
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Possible values: file, cache
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Possible values: single, daily, slack, syslogs, errorlog, monolog, custom, stack
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Possible values: debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=debug
# Possible values: sqlite, mysql, mariadb, pgsql, sqlsrv
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Possible values: database, file, cookie, redis, memcached, array
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Possible values: log, sync, redis, pusher, ably
BROADCAST_CONNECTION=log
# Possible values: local, public, s3
FILESYSTEM_DISK=local
# Possible values: sync, database, queue, beanstalkd, sqs, redis
QUEUE_CONNECTION=database
# Possible values: database, file, array, redis, memcached, octane
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Possible values: phpredis, predis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Possible values: log, smtp, sendmail, mailgun, ses, ses-v2, postmark, resend
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
